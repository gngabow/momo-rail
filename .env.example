# ── momo-rail environment ───────────────────────────────────────────────────
# The demo runs with NO env at all (mock MoMo adapter, in-memory). Set these
# only when you want to flip a market onto the REAL MTN MoMo Open API.

# Which markets run on the real MTN adapter (comma list of ISO codes).
# Everything else stays on the mock adapter.
MOMO_LIVE_MARKETS=UG

# MTN Open API environment.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox

# Where MTN posts the terminal callback for a collection/disbursement.
MOMO_CALLBACK_URL=https://momo.airtimepap.com/api/momo/callback/collection

# ── Credentials ──────────────────────────────────────────────────────────────
# Get a subscription key at https://momodeveloper.mtn.com (subscribe to the
# "Collections" product, copy its Primary Key; subscribe to "Disbursements" too
# for payouts). Then run:  MOMO_SUBSCRIPTION_KEY=<key> npm run momo:provision
# which mints the API user + API key below and prints them ready to paste.
#
# Shared credentials (one sandbox app serving every market):
MOMO_COLLECTION_SUBKEY=
# MOMO_DISBURSEMENT_SUBKEY=
MOMO_API_USER=
MOMO_API_KEY=

# Per-operator overrides (production, issued by each operating company) take
# precedence over the shared MOMO_* values above. Example for Uganda:
# MTN_UG_COLLECTION_SUBKEY=
# MTN_UG_DISBURSEMENT_SUBKEY=
# MTN_UG_API_USER=
# MTN_UG_API_KEY=
